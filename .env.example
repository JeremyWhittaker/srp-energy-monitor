# Copy to .env and fill in. .env is gitignored and never read by the API.

# --- SRP My Account credentials (required for fetching) ---------------------
# The same username and password you use at https://myaccount.srpnet.com
# NOTE: accounts with multi-factor authentication enabled cannot be automated.
SRP_USERNAME=
# Quote the value if it contains a '#' or spaces, e.g. SRP_PASSWORD="pa#ss word"
SRP_PASSWORD=

# Your SRP account number, 9 digits, no dashes (My Account shows it
# hyphenated). Required only by the JSON backend -- the browser scraper
# reads the account from the signed-in session and ignores this.
SRP_ACCOUNT_ID=

# --- Storage ----------------------------------------------------------------
SRP_DATA_DIR=./data
# SRP_DATABASE_PATH=./data/srp.db
# SRP_DOWNLOADS_DIR=./data/downloads
# Keep the raw CSVs after import (true) or delete them once parsed (false).
SRP_KEEP_DOWNLOADS=true

# --- API server -------------------------------------------------------------
# Bind to 127.0.0.1 unless you intend to expose this. It has no authentication.
SRP_HOST=127.0.0.1
SRP_PORT=8000

# --- Scraper tuning ---------------------------------------------------------
# Set to false to watch the browser work; useful when SRP changes their markup.
SRP_HEADLESS=true
SRP_TIMEOUT_MS=120000
SRP_DOWNLOAD_TIMEOUT_MS=60000

# DEBUG, INFO, WARNING, ERROR
SRP_LOG_LEVEL=INFO
